# Copy to .env and fill in:  cp .env.example .env

# Base URL of your Dreeve instance (no trailing /api path)
DREEVE_URL="https://dreeve.example.com"

# Dreeve API token (Bearer token)
DREEVE_TOKEN="changeme"

# Folder where your tracking app exports .gpx files
WATCH_DIR="/storage/emulated/0/FitoTrack"
